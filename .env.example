# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://zouhour:YOUR_APP_PASSWORD@localhost:5432/zouhour

# Long random secret used to sign login sessions (JWT). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a login session lasts before requiring re-login.
JWT_EXPIRES_HOURS=12

# The single admin account. Signup requests are emailed here for approval.
ADMIN_EMAIL=contact.ing.wissem@gmail.com

# Used to build links inside emails (frontend URL, and the backend's own
# public URL for the /auth/confirm and /auth/reject links).
APP_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8001

# SMTP for sending signup-approval emails to ADMIN_EMAIL. If left blank,
# the email is printed to the backend console instead (useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
